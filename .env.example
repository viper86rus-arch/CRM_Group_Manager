# ==============================================================================
# CRM Group Manager: Environment Configuration Template
# ==============================================================================

# 1. Серверные параметры сервиса
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SECRET_WEBHOOK_KEY=super_secret_crm_token_2026

# 2. Telegram MTProto Client (для автоматического создания групп и прав)
TG_API_ID=12345678
TG_API_HASH=abcdef0123456789abcdef0123456789
TG_PHONE=+79001234567
TG_CORPORATE_BOT_ID=@company_corp_bot

# 3. Мессенджер Макс (Корпоративный REST API)
MAX_API_URL=https://max.company.ru/api/v1
MAX_API_TOKEN=max_api_token_here
MAX_CORPORATE_BOT_ID=max_bot_sys_id

# 4. База данных сопоставления заказов и групп
DB_PATH=crm_groups.db

# 5. Демонстрационный/Тестовый режим (True = изоляция без внешних API)
DEMO_MODE=false
